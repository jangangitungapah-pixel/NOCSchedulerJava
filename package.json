{
  "name": "noc-scheduler",
  "version": "0.0.0",
  "private": true,
  "description": "NOCScheduler operational scheduling and workforce management platform.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:runtime": "node tooling/check-runtime.cjs",
    "dev": "concurrently -k -n api,web \"npm run dev --workspace @nocscheduler/api\" \"npm run dev --workspace @nocscheduler/web\"",
    "dev:api": "npm run dev --workspace @nocscheduler/api",
    "dev:web": "npm run dev --workspace @nocscheduler/web",
    "typecheck:root": "tsc -p tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:root && npm run typecheck --workspaces --if-present",
    "lint": "eslint \"tooling/**/*.ts\" \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" --max-warnings=0",
    "format": "prettier --write \"tooling/**/*.ts\" \"tooling/check-workspace-boundaries.cjs\" \"tooling/smoke-api.cjs\" \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,tsx,json}\" \"package.json\" \"tsconfig*.json\" \"eslint.config.mjs\" \".prettierrc.json\"",
    "format:check": "prettier --check \"tooling/**/*.ts\" \"tooling/check-workspace-boundaries.cjs\" \"tooling/smoke-api.cjs\" \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,tsx,json}\" \"package.json\" \"tsconfig*.json\" \"eslint.config.mjs\" \".prettierrc.json\"",
    "check:repo": "node tooling/check-repo-policy.cjs",
    "check:workspaces": "node tooling/check-workspace-boundaries.cjs",
    "build:api": "npm run build --workspace @nocscheduler/api",
    "build:web": "npm run build --workspace @nocscheduler/web",
    "build": "npm run build:api && npm run build:web",
    "smoke:api": "node tooling/smoke-api.cjs",
    "verify": "npm run check:runtime && npm run typecheck && npm run lint && npm run format:check && npm run check:repo && npm run check:workspaces && npm run build && npm run smoke:api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.4",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
