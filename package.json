{
  "name": "noc-scheduler",
  "version": "0.0.0",
  "private": true,
  "description": "NOCScheduler operational scheduling and workforce management platform.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:runtime": "node tooling/check-runtime.cjs",
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @nocscheduler/web",
    "typecheck:root": "tsc -p tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:root && npm run typecheck --workspaces --if-present",
    "lint": "eslint --no-error-on-unmatched-pattern \"tooling/**/*.ts\" \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"vitest.config.ts\" \"playwright.config.ts\" \"e2e/**/*.ts\" --max-warnings=0",
    "format": "prettier --no-error-on-unmatched-pattern --write \"tooling/**/*.ts\" \"tooling/**/*.cjs\" \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\" \"vitest.config.ts\" \"playwright.config.ts\" \"lint-staged.config.mjs\" \"knip.json\" \".github/workflows/*.yml\" \"firebase.json\" \"firestore.indexes.json\" \".firebaserc\" \"package.json\" \"tsconfig*.json\" \"eslint.config.mjs\" \".prettierrc.json\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"tooling/**/*.ts\" \"tooling/**/*.cjs\" \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\" \"vitest.config.ts\" \"playwright.config.ts\" \"lint-staged.config.mjs\" \"knip.json\" \".github/workflows/*.yml\" \"firebase.json\" \"firestore.indexes.json\" \".firebaserc\" \"package.json\" \"tsconfig*.json\" \"eslint.config.mjs\" \".prettierrc.json\"",
    "check:repo": "node tooling/check-repo-policy.cjs",
    "check:workspaces": "node tooling/check-workspace-boundaries.cjs",
    "build:web": "npm run build --workspace @nocscheduler/web",
    "build": "npm run build:web",
    "verify": "npm run check:runtime && npm run typecheck && npm run lint && npm run format:check && npm run check:repo && npm run check:workspaces && npm run check:firebase && npm test && npm run build && npm run check:deadcode",
    "test": "vitest run --project web-unit --project domain-unit --passWithNoTests",
    "test:watch": "vitest --project web-unit --project domain-unit --passWithNoTests",
    "test:coverage": "vitest run --coverage --project web-unit --project domain-unit --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test e2e/scaffold.spec.ts e2e/design-system.spec.ts --project=chromium",
    "test:a11y": "playwright test e2e/accessibility.spec.ts --project=chromium",
    "check:deadcode": "knip",
    "check:staged": "lint-staged",
    "verify:ci": "npm run check:runtime && npm run typecheck && npm run lint && npm run format:check && npm run check:repo && npm run check:workspaces && npm run check:firebase && npm test && npm run build && npm run check:deadcode",
    "test:design-system": "playwright test e2e/design-system.spec.ts --project=chromium --project=mobile-chromium",
    "check:firebase": "node tooling/firebase/check-config.cjs",
    "firebase:project": "firebase use nocschedule1",
    "firebase:serve": "npm run build:web && firebase serve --project nocschedule1 --only hosting",
    "firebase:deploy": "npm run build:web && firebase deploy --project nocschedule1 --only hosting:app,firestore",
    "firebase:deploy:hosting": "npm run build:web && firebase deploy --project nocschedule1 --only hosting:app",
    "firebase:deploy:firestore": "firebase deploy --project nocschedule1 --only firestore"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "15.26.0",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
