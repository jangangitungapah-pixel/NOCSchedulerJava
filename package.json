{
  "name": "noc-scheduler",
  "version": "0.0.0",
  "private": true,
  "description": "NOCScheduler operational scheduling and workforce management platform.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:runtime": "node tooling/check-runtime.cjs",
    "dev": "concurrently -k -n api,web \"npm run dev --workspace @nocscheduler/api\" \"npm run dev --workspace @nocscheduler/web\"",
    "dev:api": "npm run dev --workspace @nocscheduler/api",
    "dev:web": "npm run dev --workspace @nocscheduler/web",
    "typecheck:root": "tsc -p tsconfig.json --noEmit",
    "typecheck": "npm run typecheck:root && npm run typecheck --workspaces --if-present",
    "lint": "eslint --no-error-on-unmatched-pattern \"tooling/**/*.ts\" \"apps/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\" \"vitest.config.ts\" \"playwright.config.ts\" \"e2e/**/*.ts\" --max-warnings=0",
    "format": "prettier --no-error-on-unmatched-pattern --write \"tooling/**/*.ts\" \"tooling/check-workspace-boundaries.cjs\" \"tooling/smoke-api.cjs\" \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,tsx,json}\" \"e2e/**/*.ts\" \"vitest.config.ts\" \"playwright.config.ts\" \"lint-staged.config.mjs\" \"knip.json\" \".github/workflows/*.yml\" \"package.json\" \"tsconfig*.json\" \"eslint.config.mjs\" \".prettierrc.json\"",
    "format:check": "prettier --no-error-on-unmatched-pattern --check \"tooling/**/*.ts\" \"tooling/check-workspace-boundaries.cjs\" \"tooling/smoke-api.cjs\" \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,tsx,json}\" \"e2e/**/*.ts\" \"vitest.config.ts\" \"playwright.config.ts\" \"lint-staged.config.mjs\" \"knip.json\" \".github/workflows/*.yml\" \"package.json\" \"tsconfig*.json\" \"eslint.config.mjs\" \".prettierrc.json\"",
    "check:repo": "node tooling/check-repo-policy.cjs",
    "check:workspaces": "node tooling/check-workspace-boundaries.cjs",
    "build:api": "npm run build --workspace @nocscheduler/api",
    "build:web": "npm run build --workspace @nocscheduler/web",
    "build": "npm run build:api && npm run build:web",
    "smoke:api": "node tooling/smoke-api.cjs",
    "verify": "npm run check:runtime && npm run typecheck && npm run lint && npm run format:check && npm run check:repo && npm run check:workspaces && npm test && npm run test:integration && npm run build && npm run smoke:api && npm run check:deadcode",
    "test": "vitest run --project web-unit --project domain-unit --passWithNoTests",
    "test:watch": "vitest --project web-unit --project domain-unit --passWithNoTests",
    "test:integration": "vitest run --project api-integration",
    "test:coverage": "vitest run --coverage --project web-unit --project domain-unit --project api-integration --passWithNoTests",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test e2e/scaffold.spec.ts --project=chromium",
    "test:a11y": "playwright test e2e/accessibility.spec.ts --project=chromium",
    "check:deadcode": "knip",
    "check:staged": "lint-staged",
    "verify:ci": "npm run check:runtime && npm run typecheck && npm run lint && npm run format:check && npm run check:repo && npm run check:workspaces && npm test && npm run test:integration && npm run build && npm run smoke:api && npm run check:deadcode"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "10.0.4",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "knip": "6.32.2",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
