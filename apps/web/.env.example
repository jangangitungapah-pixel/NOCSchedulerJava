# Optional Firebase Web SDK public configuration overrides.
#
# NOCScheduler now connects directly to the real Firebase project nocschedule1.
# The canonical public Web SDK config is represented in firebase-config.ts.
#
# These values are public Firebase client identifiers, not Admin credentials.
# Never put service-account/private-key material in VITE_* variables.

VITE_FIREBASE_PROJECT_ID=nocschedule1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
