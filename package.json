{
  "name": "noc-scheduler",
  "version": "0.0.0",
  "private": true,
  "description": "NOCScheduler operational scheduling and workforce management platform.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:runtime": "node tooling/check-runtime.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"tooling/**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"tooling/**/*.ts\" \"package.json\" \"tsconfig*.json\" \"eslint.config.mjs\" \".prettierrc.json\"",
    "format:check": "prettier --check \"tooling/**/*.ts\" \"package.json\" \"tsconfig*.json\" \"eslint.config.mjs\" \".prettierrc.json\"",
    "check:repo": "node tooling/check-repo-policy.cjs",
    "verify": "npm run check:runtime && npm run typecheck && npm run lint && npm run format:check && npm run check:repo"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
